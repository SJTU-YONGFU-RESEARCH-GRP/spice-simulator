{
  "name": "spice-simulator",
  "private": true,
  "type": "module",
  "version": "0.2.6",
  "homepage": "https://sjtu-yongfu-research-grp.github.io/spice-simulator/",
  "description": "SPICE schematic editor Pages publish repo",
  "scripts": {
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "patch:jsx": "node scripts/patch-jsx-callsites.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "check:storage": "node scripts/storage-resilience.mjs",
    "check:numeric": "node scripts/numeric-crosscheck.mjs",
    "check:numeric:neg": "node scripts/numeric-crosscheck.negctl.mjs",
    "check:egress": "node scripts/egress-integrity.mjs",
    "check:egress:neg": "node scripts/outbound-repair.negctl.mjs",
    "check:csp": "node scripts/csp-conformance.mjs",
    "check:csp:neg": "node scripts/csp-guard.negctl.mjs",
    "check:offline": "node scripts/offline-sim.mjs",
    "check:offline:neg": "node scripts/sw-cache.negctl.mjs",
    "check:offline:neg:static": "node scripts/sw-cache.negctl.mjs --static-only",
    "check:precache": "node scripts/precache-weight.mjs",
    "check:precache:neg": "node scripts/precache-budget.negctl.mjs",
    "check:precache:neg:static": "node scripts/precache-budget.negctl.mjs --static-only",
    "check:examples": "node scripts/example-outcomes.mjs",
    "check:examples:neg": "node scripts/example-outcomes.negctl.mjs",
    "check:shellcache": "node scripts/shell-cache.mjs",
    "check:shellcache:neg": "node scripts/shell-cache.negctl.mjs",
    "check:shellcache:neg:static": "node scripts/shell-cache.negctl.mjs --static-only",
    "bump:shellcache": "node scripts/shell-cache.mjs --write",
    "patch:outbound": "node scripts/patch-outbound.mjs",
    "patch:storage": "node scripts/patch-outbound.mjs --manifest=scripts/storage-guard.json",
    "patch:csp": "node scripts/patch-outbound.mjs --manifest=scripts/shell-csp.json",
    "patch:corner": "node scripts/patch-outbound.mjs --manifest=scripts/corner-sweep.json",
    "check:corner": "node scripts/check-artifacts.mjs && node scripts/numeric-crosscheck.mjs --only=corner_default,corner_ss,corner_ff,corner_frozen",
    "check:corner:neg": "node scripts/corner-sweep.negctl.mjs",
    "patch:import": "node scripts/patch-outbound.mjs --manifest=scripts/import-libs.json",
    "check:import": "node scripts/check-artifacts.mjs && node scripts/spice-import.mjs",
    "check:import:neg": "node scripts/spice-import.negctl.mjs",
    "check:import:neg:static": "node scripts/spice-import.negctl.mjs --static-only",
    "patch:gallery": "node scripts/patch-outbound.mjs --manifest=scripts/gallery-shim.json",
    "check:gallery": "node scripts/check-artifacts.mjs && node scripts/gallery-shim.mjs",
    "check:gallery:neg": "node scripts/gallery-shim.negctl.mjs",
    "check:gallery:neg:static": "node scripts/gallery-shim.negctl.mjs --static-only",
    "preview": "node scripts/serve-local.mjs",
    "publish:editor": "bash scripts/publish-editor-pages.sh",
    "release": "bash scripts/release.sh",
    "release:dry": "bash scripts/release.sh --dry-run",
    "patch:identity": "node scripts/patch-outbound.mjs --manifest=scripts/example-identity.json",
    "check:identity": "node scripts/check-artifacts.mjs && node scripts/example-outcomes.mjs",
    "check:identity:neg": "node scripts/example-identity.negctl.mjs",
    "check:identity:neg:static": "node scripts/example-identity.negctl.mjs --static-only",
    "build:margin": "node scripts/stability-margin.manifest.cjs",
    "patch:margin": "node scripts/patch-outbound.mjs --manifest=scripts/stability-margin.json",
    "check:margin": "node scripts/check-artifacts.mjs && node scripts/stability-margin.oracle.mjs",
    "check:margin:neg": "node scripts/stability-margin.negctl.mjs",
    "check:margin:neg:static": "node scripts/stability-margin.negctl.mjs --static-only",
    "check:margin:browser": "node scripts/stability-margin.mjs",
    "check:margin:browser:fixture": "node scripts/stability-margin.mjs --fixture=center-magnitude",
    "build:region": "node scripts/region-annotate.manifest.cjs",
    "patch:region": "node scripts/patch-outbound.mjs --manifest=scripts/region-annotate.json",
  "check:region": "node scripts/check-artifacts.mjs && node scripts/region-annotate.oracle.mjs",
  "check:region:neg": "node scripts/region-annotate.negctl.mjs",
  "check:region:browser": "node scripts/region-annotate.mjs",
  "check:cornermap": "node scripts/check-artifacts.mjs",
  "check:cornermap:neg": "node scripts/corner-mapping.negctl.mjs",
    "audit:ux": "node scripts/ux-audit.mjs"
  }
}
